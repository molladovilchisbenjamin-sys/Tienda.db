<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.datapars.tiendita.PrimaryController">

   <children>
      <Label text="Productos" />
      <Label fx:id="lblConexion"/>

      <!-- Formulario -->
      <HBox alignment="CENTER" spacing="8.0">
         <children>
            <TextField fx:id="txtProducto"   promptText="Producto"   prefWidth="180"/>
            <TextField fx:id="txtPrecio"     promptText="Precio"     prefWidth="100"/>
            <TextField fx:id="txtFabricante" promptText="Fabricante" prefWidth="150"/>
         </children>
      </HBox>

      <!-- Botones del formulario -->
      <HBox alignment="CENTER" spacing="8.0">
         <children>
            <Button fx:id="btnInsertar"   text="Insertar"            onAction="#onInsertar"/>
            <Button fx:id="btnActualizar" text="Actualizar"          onAction="#onActualizar"/>
            <Button fx:id="btnLimpiar"    text="Limpiar / Nuevo"     onAction="#onLimpiar"/>
         </children>
      </HBox>

      <!-- Tabla -->
      <TableView fx:id="tblProductos" prefHeight="400.0" prefWidth="640.0">
         <columns>
            <TableColumn fx:id="colId"         text="ID"         prefWidth="60"  />
            <TableColumn fx:id="colProducto"   text="Producto"   prefWidth="220" />
            <TableColumn fx:id="colPrecio"     text="Precio"     prefWidth="120" />
            <TableColumn fx:id="colFabricante" text="Fabricante" prefWidth="160" />
         </columns>
      </TableView>

      <!-- Botón Eliminar (actúa sobre la fila seleccionada) -->
      <HBox alignment="CENTER" spacing="8.0">
         <children>
            <Button fx:id="btnEliminar" text="Eliminar seleccionado" onAction="#onEliminar"/>
         </children>
      </HBox>
   </children>

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>